# ------------------------------------------------------------------
# KERN CMS — Server environment (copy to .env and fill in)
# ------------------------------------------------------------------

# App
NODE_ENV="development"
PORT=4000
PUBLIC_API_URL="http://localhost:4000"

# Database (local Docker: mongodb://localhost:27017/kern)
DATABASE_URL="mongodb://localhost:27017/kern"

# Admin JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
COOKIE_SECURE="false"

# CORS — comma-separated origins allowed to call the API with credentials
# (public site on 3000 AND admin dashboard on 3001 — both talk to this API)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Cloudinary (media library) — optional; uploads fail gracefully when empty
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="kern-studio"

# Revalidation — the CMS server calls the public site's /api/revalidate after
# every save so cached content is purged. REVALIDATE_SECRET MUST match
# client/.env.local (REVALIDATE_SECRET), or the public site will keep serving
# stale cached content after admin edits.
REVALIDATE_SECRET="change-me-to-a-long-random-string"
REVALIDATE_URL="http://localhost:3000/api/revalidate"

# Explicit DNS resolvers (fixes hosted-DB resolution on some Windows setups)
DNS_SERVERS="8.8.8.8,1.1.1.1"

# Seed
SEED_ADMIN_EMAIL="admin@kern.studio"
SEED_ADMIN_PASSWORD="KernAdmin!2026"
